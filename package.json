{
  "name": "dsh-plugin-open-in-app-fix",
  "version": "1.0.0",
  "private": true,
  "description": "Repair for DeepSeek Harness 'Open In ...': detached GUI launches no longer inherit ELECTRON_RUN_AS_NODE, so Electron editors (VS Code, Insiders, Cursor, Windsurf) start normally instead of failing with \"打开失败，请重试\".",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "cordis.patch.yml.tpl",
    "install.ps1",
    "install.mjs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "open-in-app",
    "vscode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcy0chenyuan0/dsh-plugin-open-in-app-fix.git"
  },
  "homepage": "https://github.com/jcy0chenyuan0/dsh-plugin-open-in-app-fix#readme",
  "bugs": {
    "url": "https://github.com/jcy0chenyuan0/dsh-plugin-open-in-app-fix/issues"
  }
}
